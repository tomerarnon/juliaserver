#!/usr/bin/env bash

set -euo pipefail

VERSION="1.2.1"

# ==============================================================================
# Julia + Tmux Session Management CLI
# ==============================================================================

show_help() {
    cat << EOF
juliaserver (jls) - Persistent Julia REPL sessions in tmux (v$VERSION)

USAGE:  jls <command> [target] [args...]

TARGET can be: . (current dir), @env, a path, or a named session label.
If omitted, the global session is used.

COMMANDS:
    launch [PROJECT] [--name|-n NAME] [--history-limit N]
        Start a Julia REPL session in tmux. Loads Revise.jl for auto-reloading.
        --name/-n creates a named session (e.g. --name analysis → julia_analysis).
        --history-limit sets the session's tmux scrollback in lines (default
        100000; also settable via JULIASERVER_HISTORY_LIMIT). Large test suites
        overflow tmux's 2000-line default and their output is lost.

    run [TARGET] <SCRIPT> [FLAGS] [ARGS...]
        Run a script in an existing session (isolated module by default).
        FLAGS:  -o/--output       capture and display output (waits for completion)
                -m/--run-in-main  run in Main namespace instead of isolated module
                -a/--attach       attach to session after sending script
                --no-color        strip ANSI color codes from output
        Extra args after flags are passed to the script via Julia's ARGS.

    print [TARGET] [LINES] [--no-color]
        Show output from the last command. Detects errors and shows stacktraces.
        LINES: show last N lines instead of output since last command.

    send [TARGET] <CODE|interrupt>
        Send Julia code or Ctrl+C to a session. Runs in Main (not isolated).

    wait [TARGET] [--timeout SECS]
        Block until a running command finishes (polls for julia> prompt).
        Returns exit code 1 on timeout.

    attach [TARGET]
        Attach to the session's tmux terminal. Detach with Ctrl+b d.

    list        List all running sessions
    info        Show details (project, uptime, memory, PIDs) for all sessions
    kill        Kill a session
    killall     Kill all Julia sessions

EXAMPLES:
    jls launch .                          # start session for current project
    jls launch . --name analysis          # named session "julia_analysis"
    jls launch . --history-limit 500000   # bigger scrollback for very chatty suites
    jls run . script.jl -o                # run script, show output
    jls run analysis script.jl            # run in named session
    jls run . script.jl -m arg1 arg2      # run in Main with arguments
    jls print                             # check last command's output
    jls send . 'using Plots'              # load a package
    jls send . interrupt                  # Ctrl+C
    jls attach .                          # interactive REPL access
    jls wait . && jls print .             # wait then show output
    jls list                              # see all sessions
    jls kill analysis                     # kill named session

SESSION NAMING:
    (none)          → julia_global
    @dev            → julia_dev
    . or /path      → julia_<basename>_<hash>
    --name foo      → julia_foo

Named sessions let you run multiple sessions for the same project.
After launch, use the label directly: jls run analysis script.jl

For more information, see: https://github.com/tomerarnon/juliaserver

EOF
}

show_version() {
    echo "juliaserver version $VERSION"
}

# ==============================================================================
# Helper Functions
# ==============================================================================

_julia_session_name_from_project() {
    local project="$1"

    # Handle empty/global environment
    if [[ -z "$project" ]]; then
        echo "julia_global"
        return
    fi

    # Handle @environment syntax
    if [[ "$project" == @* ]]; then
        # Strip the @ and use as session name
        local env_name="${project:1}"
        echo "julia_${env_name}"
        return
    fi

    # For paths, use basename + short hash for uniqueness
    local full_path=$(cd "$project" 2>/dev/null && pwd || echo "$project")
    local basename=$(basename "$full_path")

    # Sanitize basename (replace spaces/special chars with underscores)
    basename=$(echo "$basename" | tr ' -' '_' | tr -cd '[:alnum:]_')

    # Generate short hash for uniqueness
    local hash=$(echo -n "$full_path" | md5 | cut -c1-4)

    echo "julia_${basename}_${hash}"
}

_resolve_session_name() {
    # Resolve a target argument to a tmux session name.
    # Resolution order:
    #   1. Already a session name (julia_*)
    #   2. Named session exists (tmux has julia_<target>)
    #   3. Treat as project spec and use deterministic naming
    local target="$1"

    if [[ "$target" == julia_* ]]; then
        echo "$target"
    elif tmux has-session -t "julia_$target" 2>/dev/null; then
        echo "julia_$target"
    else
        _julia_session_name_from_project "$target"
    fi
}

_run_marker_code() {
    # Echo the exit status recorded by the most recent `run` in this session,
    # or nothing if that run has not finished (or predates this feature).
    local session_name="$1"
    local run_id
    run_id=$(tmux show-options -t "$session_name" -qv @juliaserver_runid 2>/dev/null)
    [[ -z "$run_id" ]] && return 1
    tmux capture-pane -t "$session_name" -p -J -S - 2>/dev/null \
        | sed 's/\x1b\[[0-9;]*m//g' \
        | grep -oE "__JLS_DONE__ ${run_id} [0-9]+" \
        | tail -1 | awk '{print $3}'
}

_wait_for_marker() {
    # Poll until the current run's completion marker appears. Returns 0 when it
    # does, 1 on timeout. Unlike prompt detection this cannot report success
    # before the command has started, because the marker is printed by the
    # command itself.
    local session_name="$1" timeout="${2:-0}" poll=0.2 elapsed=0 code=""
    while true; do
        code=$(_run_marker_code "$session_name")
        if [[ -n "$code" ]]; then
            _JLS_LAST_CODE="$code"
            return 0
        fi
        sleep "$poll"
        elapsed=$(echo "$elapsed + $poll" | bc)
        if [[ "$timeout" != "0" ]] && (( $(echo "$elapsed >= $timeout" | bc -l) )); then
            return 1
        fi
    done
}

_is_session_idle() {
    # Check if the Julia REPL is idle by examining the line at the cursor position.
    # When idle, the cursor sits on a "julia>" prompt line.
    # When a command is running, the cursor is below the prompt (on output or blank line).
    # Returns 0 if idle, 1 if a command is running.
    local session_name="$1"

    local cursor_y
    cursor_y=$(tmux display-message -t "$session_name" -p '#{cursor_y}')

    # Capture just the line at the cursor position
    local cursor_line
    cursor_line=$(tmux capture-pane -t "$session_name" -p -S "$cursor_y" -E "$cursor_y")

    # Strip ANSI codes for matching
    cursor_line=$(echo "$cursor_line" | sed 's/\x1b\[[0-9;]*m//g')

    if [[ "$cursor_line" == julia\>* ]]; then
        return 0  # idle — cursor is on a prompt line
    fi

    return 1  # running — cursor is below the prompt
}

_wait_for_idle() {
    # Poll until the session is idle or timeout is reached.
    # Returns 0 on idle, 1 on timeout.
    local session_name="$1"
    local timeout="${2:-0}"  # 0 = no timeout
    local poll_interval=0.5

    # Brief initial delay so a just-sent command has time to start executing
    sleep 0.2

    local elapsed=0
    while true; do
        if _is_session_idle "$session_name"; then
            return 0
        fi

        sleep "$poll_interval"
        elapsed=$(echo "$elapsed + $poll_interval + 0" | bc)

        if [[ "$timeout" != "0" ]] && (( $(echo "$elapsed >= $timeout" | bc -l) )); then
            return 1
        fi
    done
}

# ==============================================================================
# Commands
# ==============================================================================

cmd_launch() {
    local project="${1:-}"
    local label="${_JLS_SESSION_LABEL:-}"
    local session_name
    local proj_desc="${project:-global environment}"

    if [[ -n "$label" ]]; then
        # Sanitize label: lowercase, replace non-alnum with underscores, collapse runs
        local sanitized=$(echo "$label" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
        if [[ -z "$sanitized" ]]; then
            echo "Error: --name value '$label' contains no valid characters"
            return 1
        fi
        session_name="julia_${sanitized}"
    else
        session_name=$(_julia_session_name_from_project "$project")
    fi

    # Check if session already exists
    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "A Julia session '$session_name' is already running for: $proj_desc"
        echo "1) Kill and relaunch"
        echo "2) Cancel"
        echo -n "Choose an option (1 or 2): "
        read choice

        if [[ "$choice" == "1" ]]; then
            echo "Killing existing session '$session_name'..."
            tmux kill-session -t "$session_name"
            sleep 1
        else
            echo "Aborting."
            return 1
        fi
    fi

    echo "Starting Julia session '$session_name' for: $proj_desc"

    # Create new tmux session with bash, then start Julia from within it
    # history-limit is read when a pane is created, so it must be set before
    # new-session. Set it globally just long enough to create ours, then restore
    # whatever the user had. Without this, tmux's 2000-line default silently
    # truncates output from large test suites.
    # scrollback size: --history-limit flag > JULIASERVER_HISTORY_LIMIT > default
    local _jls_hist="${_JLS_HISTORY_LIMIT:-${JULIASERVER_HISTORY_LIMIT:-100000}}"
    if ! [[ "$_jls_hist" =~ ^[0-9]+$ ]]; then
        echo "Error: history limit must be a non-negative integer (got '$_jls_hist')"
        return 1
    fi
    local _jls_boot="_juliaserver_boot_$$"
    local _jls_prev_hist=""
    # A tmux server only exists while it owns a session, so create a throwaway
    # one first, raise the global limit long enough to create ours with a large
    # buffer, then put the user's global back and drop the throwaway.
    tmux new-session -d -s "$_jls_boot" 2>/dev/null || true
    _jls_prev_hist=$(tmux show-options -gv history-limit 2>/dev/null || echo "")
    tmux set-option -g history-limit "$_jls_hist" 2>/dev/null || true
    tmux new-session -d -s "$session_name"
    tmux set-option -t "$session_name" history-limit "$_jls_hist" 2>/dev/null || true
    if [[ -n "$_jls_prev_hist" ]]; then
        tmux set-option -g history-limit "$_jls_prev_hist" 2>/dev/null || true
    fi
    tmux kill-session -t "$_jls_boot" 2>/dev/null || true

    # Store the original project path for later retrieval
    if [[ -n "$project" ]]; then
        # Convert to absolute path if it's a relative path
        local stored_path="$project"
        if [[ "$project" != /* ]] && [[ "$project" != @* ]] && [[ "$project" != "." ]]; then
            stored_path=$(cd "$project" 2>/dev/null && pwd || echo "$project")
        elif [[ "$project" == "." ]]; then
            stored_path=$(pwd)
        fi
        tmux set-option -t "$session_name" @juliaserver_project "$stored_path"
    fi

    # Store the label for later retrieval (list, info, completion)
    if [[ -n "$label" ]]; then
        tmux set-option -t "$session_name" @juliaserver_label "$label"
    fi

    # Wait a moment for tmux to be ready
    sleep 1

    # Start Julia with appropriate project setting
    if [[ -z "$project" ]]; then
        tmux send-keys -t "$session_name" 'julia -t auto' C-m
    else
        tmux send-keys -t "$session_name" "julia --project=\"$project\" -t auto" C-m
    fi

    # Wait for Julia to start
    sleep 3

    # Load Revise if available (silently skip if not installed)
    tmux send-keys -t "$session_name" 'if Base.find_package("Revise") !== nothing; using Revise; end' C-m

    # Warn on the user-facing terminal if Revise isn't installed
    if ! grep -rq "Revise" "$HOME/.julia/environments"/*/Project.toml 2>/dev/null; then
        echo "Note: Revise.jl not found. Add to your global Julia environment for auto-reloading."
    fi

    echo "Session '$session_name' started successfully!"
    if [[ -n "$label" ]]; then
        local sanitized="${session_name#julia_}"
        echo "Use 'juliaserver run $sanitized <script.jl>' to run scripts"
        echo "Use 'juliaserver attach $sanitized' to attach to the session"
    elif [[ -n "$project" ]]; then
        echo "Use 'juliaserver run $project <script.jl>' to run scripts"
        echo "Use 'juliaserver attach $project' to attach to the session"
    else
        echo "Use 'juliaserver run <script.jl>' to run scripts"
        echo "Use 'juliaserver attach' to attach to the session"
    fi
}

cmd_run() {
    local project=""
    local script=""
    local should_attach=0
    local show_output=0
    local no_color=0
    local isolated=1  # Default to isolated mode

    # Check if first arg is a project spec, named session, or script
    local session_name=""
    if [[ "$1" == @* ]] || [[ "$1" == "." ]] || [[ -d "$1" ]]; then
        project="$1"
        shift
    elif tmux has-session -t "julia_$1" 2>/dev/null; then
        session_name="julia_$1"
        shift
    fi

    # Get the script path
    script="$1"
    shift

    if [[ -z "$script" ]]; then
        echo "Error: No script specified"
        echo "Usage: juliaserver run [project] <script.jl> [--attach|-a] [--output|-o] [--run-in-main|-m] [--no-color] [args...]"
        return 1
    fi

    # Parse flags
    local script_args=()
    for arg in "$@"; do
        case "$arg" in
            --attach|-a)
                should_attach=1
                ;;
            --output|-o)
                show_output=1
                ;;
            --run-in-main|-m)
                isolated=0
                ;;
            --no-color)
                no_color=1
                ;;
            *)
                script_args+=("$arg")
                ;;
        esac
    done

    # Get session name (if not already resolved via named session)
    if [[ -z "$session_name" ]]; then
        session_name=$(_resolve_session_name "$project")
    fi

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' is not running"
        if [[ -z "$project" ]]; then
            echo "Start it first with: juliaserver launch"
        else
            echo "Start it first with: juliaserver launch $project"
        fi
        return 1
    fi

    # Convert to absolute path if relative
    if [[ "$script" != /* ]]; then
        script="$(pwd)/$script"
    fi

    echo "Running $script in session '$session_name'..."
    if [[ $isolated -eq 1 ]]; then
        echo "Mode: isolated (in JLSClientModule)"
    else
        echo "Mode: running in Main namespace"
    fi

    # Build the Julia command with ARGS if there are arguments
    local julia_cmd
    local include_cmd

    if [[ ${#script_args[@]} -gt 0 ]]; then
        # Build Julia array of arguments, properly escaped
        local args_str=""
        for arg in "${script_args[@]}"; do
            # Escape backslashes and quotes in the argument
            local escaped_arg="${arg//\\/\\\\}"
            escaped_arg="${escaped_arg//\"/\\\"}"
            args_str="${args_str}\"${escaped_arg}\", "
        done
        # Remove trailing comma and space
        args_str="${args_str%, }"

        include_cmd="empty!(ARGS); append!(ARGS, [${args_str}]); include(\"$script\")"
        echo "With arguments: ${script_args[*]}"
    else
        include_cmd="include(\"$script\")"
    fi

    # Tag this run so `wait` and `print` can find its completion marker rather
    # than guessing from cursor position. The marker is printed from two string
    # literals so that the echoed command line itself never matches the grep.
    local _jls_run_rc=0
    local run_id="$$-${RANDOM}-$(date +%s)"
    local emit="println(\"__JLS\" * \"_DONE__ ${run_id} \", __JLS_RC__)"

    if [[ $isolated -eq 1 ]]; then
        julia_cmd="module JLSClientModule; try; ${include_cmd}; global __JLS_RC__ = 0; catch e; Base.showerror(Base.stderr, e, Base.catch_backtrace()); Base.println(Base.stderr); global __JLS_RC__ = 1; end; end; println(\"__JLS\" * \"_DONE__ ${run_id} \", JLSClientModule.__JLS_RC__)"
    else
        julia_cmd="try; ${include_cmd}; global __JLS_RC__ = 0; catch e; Base.showerror(Base.stderr, e, Base.catch_backtrace()); Base.println(Base.stderr); global __JLS_RC__ = 1; end; ${emit}"
    fi

    tmux set-option -t "$session_name" @juliaserver_runid "$run_id" 2>/dev/null || true

    # Send the include command
    tmux send-keys -t "$session_name" "$julia_cmd" C-m

    # Attach to the session only if --attach or -a flag was provided
    if [[ $should_attach -eq 1 ]]; then
        echo "Attaching to session (press Ctrl+b then d to detach)..."
        sleep 0.5
        tmux attach -t "$session_name"
    else
        echo "Script sent to session '$session_name'"

        # Capture and display output only if --output flag was provided
        if [[ $show_output -eq 1 ]]; then
            # Wait for command to finish
            if ! _wait_for_marker "$session_name" 0; then
                echo "Warning: timed out waiting for command to finish"
            fi
            _jls_run_rc="${_JLS_LAST_CODE:-0}"

            # Capture output using cmd_print logic
            local print_args=("$session_name")
            if [[ $no_color -eq 1 ]]; then
                print_args+=("--no-color")
            fi
            cmd_print "${print_args[@]}"
        fi

        echo ""
        echo "Use 'juliaserver attach $project' to attach to the session"
    fi

    # With --output we waited for the script, so we can report its status.
    # Without it, `run` stays fire-and-forget and returns 0 as before.
    return "${_jls_run_rc:-0}"
}

cmd_print() {
    local target=""
    local no_color=0
    local num_lines=""

    # Parse arguments
    for arg in "$@"; do
        case "$arg" in
            --no-color)
                no_color=1
                ;;
            *)
                # Check if it's a number (lines to capture)
                if [[ "$arg" =~ ^[0-9]+$ ]]; then
                    num_lines="$arg"
                # Otherwise it's the target
                elif [[ -z "$target" ]]; then
                    target="$arg"
                fi
                ;;
        esac
    done

    # Get session name
    local session_name=$(_resolve_session_name "$target")

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' not found"
        echo "Use 'juliaserver list' to see running sessions"
        return 1
    fi

    # Capture output with ANSI codes (including scrollback history)
    local captured_output=$(tmux capture-pane -t "$session_name" -p -e -J -S -)
    local output_lines=""

    # If num_lines is specified, just capture that many lines
    if [[ -n "$num_lines" ]]; then
        output_lines=$(echo "$captured_output" | tail -n "$num_lines")
    else
        # Default: capture output between last two julia> prompts
        # Get all julia> prompt line numbers (strip ANSI codes for pattern matching)
        local captured_no_ansi=$(echo "$captured_output" | sed 's/\x1b\[[0-9;]*m//g')
        local prompt_lines=$(echo "$captured_no_ansi" | grep -n "^julia>" | cut -d: -f1)
        local prompt_array=($prompt_lines)
        local num_prompts=${#prompt_array[@]}

        if [[ $num_prompts -eq 0 ]]; then
            echo "No Julia prompt found in session '$session_name'"
            return 1
        fi

        # Check if a command is currently running (last line is not a prompt)
        local total_lines=$(echo "$captured_no_ansi" | wc -l | tr -d ' ')
        local last_prompt_line=${prompt_array[$((num_prompts - 1))]}
        local command_running=0

        # If the last prompt is not on the last line, a command is running
        if [[ $last_prompt_line -lt $total_lines ]]; then
            command_running=1
        fi

        if [[ $command_running -eq 1 ]]; then
            # Command is running: show output from last prompt to end
            output_lines=$(echo "$captured_output" | sed -n "$((last_prompt_line + 1)),${total_lines}p")
        else
            # Command finished: show output between last two prompts
            # Need at least 2 prompts to show output between them
            if [[ $num_prompts -lt 2 ]]; then
                echo "Output from session '$session_name':"
                echo "========================================"
                echo "(no commands have been executed yet)"
                echo "========================================"
                return 0
            fi

            # Get second-to-last and last prompt lines
            local start_line=${prompt_array[$((num_prompts - 2))]}
            local end_line=${prompt_array[$((num_prompts - 1))]}

            # Extract everything between these two prompts (excluding the prompts themselves)
            # Note: The command is on the same line as the prompt when using send-keys,
            # so the extracted lines are pure output
            output_lines=$(echo "$captured_output" | sed -n "$((start_line + 1)),$((end_line - 1))p")

            # If no output from the most recent command, try the previous cell
            if [[ -z "$(echo "$output_lines" | tr -d '[:space:]')" ]] && [[ $num_prompts -ge 3 ]]; then
                # Get third-to-last and second-to-last prompt lines
                start_line=${prompt_array[$((num_prompts - 3))]}
                end_line=${prompt_array[$((num_prompts - 2))]}

                # Extract everything between these two prompts
                output_lines=$(echo "$captured_output" | sed -n "$((start_line + 1)),$((end_line - 1))p")
            fi
        fi
    fi

    # Strip ANSI codes if --no-color flag is set
    if [[ $no_color -eq 1 ]]; then
        output_lines=$(echo "$output_lines" | sed 's/\x1b\[[0-9;]*m//g')
    fi

    # Check for errors in the output (strip ANSI codes for checking only)
    local has_error=0
    local error_output=""
    local output_for_check=$(echo "$output_lines" | sed 's/\x1b\[[0-9;]*m//g')
    if echo "$output_for_check" | grep -q "^ERROR:"; then
        has_error=1
        # Extract error and stacktrace, preserving ANSI codes unless --no-color was set
        if [[ $no_color -eq 1 ]]; then
            error_output=$(echo "$output_for_check" | sed -n '/^ERROR:/,$p')
        else
            error_output=$(echo "$output_lines" | sed 's/\x1b\[[0-9;]*m//g' | sed -n '/^ERROR:/,$p')
            # Re-extract with ANSI codes by finding the line in original output
            local first_error_line=$(echo "$output_for_check" | grep -n "^ERROR:" | head -1 | cut -d: -f1)
            if [[ -n "$first_error_line" ]]; then
                error_output=$(echo "$output_lines" | tail -n +$first_error_line)
            fi
        fi
    fi

    # Display output
    if [[ $has_error -eq 1 ]] && [[ -z "$num_lines" ]]; then
        # Error detected and no numeric flag: show only error and stacktrace
        echo "Output from session '$session_name':"
        echo "========================================"
        echo "$error_output"
        echo "========================================"
    else
        # Normal output display (might include error if num_lines was specified)
        echo "Output from session '$session_name':"
        echo "========================================"
        if [[ -n "$output_lines" ]]; then
            echo "$output_lines"
        else
            echo "(no output since last prompt)"
        fi
        echo "========================================"
    fi
}

cmd_wait() {
    local target=""
    local timeout=0  # 0 = no timeout

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout)
                if [[ -z "${2:-}" ]]; then
                    echo "Error: --timeout requires a value in seconds"
                    return 1
                fi
                timeout="$2"
                shift 2
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    # Get session name
    local session_name=$(_resolve_session_name "$target")

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' not found"
        echo "Use 'juliaserver list' to see running sessions"
        return 1
    fi

    # If this session has a tagged run, wait on its completion marker and
    # propagate the script's exit status. This is both race-free and gives the
    # caller a real pass/fail signal.
    if tmux show-options -t "$session_name" -qv @juliaserver_runid 2>/dev/null | grep -q .; then
        if _wait_for_marker "$session_name" "$timeout"; then
            if [[ "${_JLS_LAST_CODE:-0}" == "0" ]]; then
                echo "Command completed."
                return 0
            else
                echo "Command failed (exit ${_JLS_LAST_CODE})."
                return "${_JLS_LAST_CODE}"
            fi
        else
            echo "Timeout: command still running after ${timeout}s."
            return 124
        fi
    fi

    # If already idle, return immediately
    if _is_session_idle "$session_name"; then
        echo "Session '$session_name' is idle."
        return 0
    fi

    # Wait for completion
    if _wait_for_idle "$session_name" "$timeout"; then
        echo "Command completed."
        return 0
    else
        echo "Timeout: command still running after ${timeout}s."
        return 1
    fi
}

cmd_list() {
    echo "Running Julia tmux sessions:"
    echo "============================="

    local found=0

    # Get all tmux sessions that start with "julia_"
    while IFS= read -r session_line; do
        if [[ -z "$session_line" ]]; then
            continue
        fi

        # Parse session name (format: "session_name: X windows (created ...)")
        local session_name=$(echo "$session_line" | cut -d: -f1)

        if [[ "$session_name" == julia_* ]]; then
            found=1

            # Determine project info from session name or stored option
            local project_info=""
            if [[ "$session_name" == "julia_global" ]]; then
                project_info="global environment"
            else
                # Try to get stored project path
                local stored_project=$(tmux show-option -t "$session_name" -v @juliaserver_project 2>/dev/null)
                if [[ -n "$stored_project" ]]; then
                    project_info="$stored_project"
                else
                    # Fallback to session name parsing
                    local proj_name="${session_name#julia_}"
                    if [[ "$proj_name" == *"_"* ]]; then
                        # Likely a path-based session, but we can't recover the full path
                        project_info="@$proj_name or path"
                    else
                        # Likely an @env session
                        project_info="@$proj_name"
                    fi
                fi
            fi

            # Check for named session label
            local label_info=""
            local stored_label=$(tmux show-option -t "$session_name" -v @juliaserver_label 2>/dev/null)
            if [[ -n "$stored_label" ]]; then
                label_info=" | Label: $stored_label"
            fi

            # Check if session is attached
            local attached=""
            if echo "$session_line" | grep -q "attached"; then
                attached=" (attached)"
            fi

            echo "Session: $session_name | Project: $project_info${label_info}$attached"
        fi
    done < <(tmux list-sessions 2>/dev/null)

    if [[ $found -eq 0 ]]; then
        echo "No Julia tmux sessions running."
        echo "Start one with: juliaserver launch [project]"
    fi
}

cmd_kill() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: juliaserver kill <session_name|project_spec>"
        echo "Example: juliaserver kill julia_global"
        echo "Example: juliaserver kill @dev"
        echo "Example: juliaserver kill ."
        return 1
    fi

    local target="$1"
    local session_name=$(_resolve_session_name "$target")

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' not found"
        echo "Use 'juliaserver list' to see running sessions"
        return 1
    fi

    echo "Killing Julia session '$session_name'..."
    tmux kill-session -t "$session_name"
    echo "Session killed."
}

cmd_attach() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: juliaserver attach <session_name|project_spec>"
        echo "Example: juliaserver attach julia_global"
        echo "Example: juliaserver attach @dev"
        echo "Example: juliaserver attach ."
        return 1
    fi

    local target="$1"
    local session_name=$(_resolve_session_name "$target")

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' not found"
        echo "Use 'juliaserver list' to see running sessions"
        return 1
    fi

    echo "Attaching to session '$session_name'..."
    tmux attach -t "$session_name"
}

cmd_send() {
    local project=""
    local command=""

    # Check if any arguments provided
    if [[ $# -eq 0 ]]; then
        echo "Error: No command specified"
        echo "Usage: juliaserver send [project] <command|interrupt>"
        echo ""
        echo "Examples:"
        echo "  juliaserver send interrupt                 # Send Ctrl+C to global session"
        echo "  juliaserver send @dev interrupt            # Send Ctrl+C to @dev session"
        echo "  juliaserver send 'println(\"hello\")'      # Execute Julia code in global"
        echo "  juliaserver send @dev 'x = 42'             # Execute Julia code in @dev"
        return 1
    fi

    # Check if first arg is a project spec, session name, or named session
    local session_name=""
    if [[ "$1" == julia_* ]] || [[ "$1" == @* ]] || [[ "$1" == "." ]] || [[ -d "$1" ]]; then
        project="$1"
        shift
    elif tmux has-session -t "julia_$1" 2>/dev/null; then
        session_name="julia_$1"
        shift
    fi

    # Get the command (everything remaining)
    command="$*"

    if [[ -z "$command" ]]; then
        echo "Error: No command specified"
        echo "Usage: juliaserver send [project] <command|interrupt>"
        echo ""
        echo "Examples:"
        echo "  juliaserver send interrupt                 # Send Ctrl+C to global session"
        echo "  juliaserver send @dev interrupt            # Send Ctrl+C to @dev session"
        echo "  juliaserver send 'println(\"hello\")'      # Execute Julia code in global"
        echo "  juliaserver send @dev 'x = 42'             # Execute Julia code in @dev"
        return 1
    fi

    # Get session name (if not already resolved via named session)
    if [[ -z "$session_name" ]]; then
        session_name=$(_resolve_session_name "$project")
    fi

    # Check if session exists
    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Error: Julia session '$session_name' is not running"
        if [[ -z "$project" ]]; then
            echo "Start it first with: juliaserver launch"
        else
            echo "Start it first with: juliaserver launch $project"
        fi
        return 1
    fi

    # Handle special case: interrupt
    if [[ "$command" == "interrupt" ]]; then
        echo "Sending interrupt (Ctrl+C) to session '$session_name'..."
        tmux send-keys -t "$session_name" C-c
        echo "Interrupt sent."
    else
        # Send arbitrary command
        echo "Sending command to session '$session_name': $command"
        # Anything sent outside of `run` has no completion marker, so drop the tag
    # and let `wait` fall back to prompt detection.
    tmux set-option -t "$session_name" -u @juliaserver_runid 2>/dev/null || true
    tmux send-keys -t "$session_name" "$command" C-m
        echo "Command sent."
    fi
}

cmd_killall() {
    local killed=0

    # Get all tmux sessions that start with "julia_"
    while IFS= read -r session_line; do
        if [[ -z "$session_line" ]]; then
            continue
        fi

        # Parse session name (format: "session_name: X windows (created ...)")
        local session_name=$(echo "$session_line" | cut -d: -f1)

        if [[ "$session_name" == julia_* ]]; then
            echo "Killing session '$session_name'..."
            tmux kill-session -t "$session_name" 2>/dev/null
            ((killed++)) || true
        fi
    done < <(tmux list-sessions 2>/dev/null)

    if [[ $killed -eq 0 ]]; then
        echo "No Julia sessions found to kill."
    else
        echo "Killed $killed Julia session(s)."
    fi
}

_format_bytes() {
    local bytes=$1
    if [[ $bytes -ge 1073741824 ]]; then
        awk "BEGIN {printf \"%.2f GB\", $bytes / 1073741824}"
    elif [[ $bytes -ge 1048576 ]]; then
        awk "BEGIN {printf \"%.2f MB\", $bytes / 1048576}"
    elif [[ $bytes -ge 1024 ]]; then
        awk "BEGIN {printf \"%.2f KB\", $bytes / 1024}"
    else
        printf "%d B" $bytes
    fi
}

_format_uptime() {
    local seconds=$1
    local days=$((seconds / 86400))
    local hours=$(((seconds % 86400) / 3600))
    local minutes=$(((seconds % 3600) / 60))
    local secs=$((seconds % 60))
    
    if [[ $days -gt 0 ]]; then
        printf "%dd %dh %dm %ds" $days $hours $minutes $secs
    elif [[ $hours -gt 0 ]]; then
        printf "%dh %dm %ds" $hours $minutes $secs
    elif [[ $minutes -gt 0 ]]; then
        printf "%dm %ds" $minutes $secs
    else
        printf "%ds" $secs
    fi
}

_get_julia_processes_for_session() {
    local session_name="$1"
    local julia_pids=()
    
    # Get all pane PIDs for this session
    local pane_pids=$(tmux list-panes -t "$session_name" -F "#{pane_pid}" 2>/dev/null)
    
    if [[ -z "$pane_pids" ]]; then
        echo ""
        return
    fi
    
    # Find Julia processes that are descendants of these pane PIDs
    # We'll search for all Julia processes and check if they're related to our panes
    while IFS= read -r julia_proc; do
        if [[ -z "$julia_proc" ]]; then
            continue
        fi
        
        # Extract PID from ps output (format varies, try common formats)
        local pid=$(echo "$julia_proc" | awk '{print $2}')
        
        # Check if this process or any ancestor is one of our pane PIDs
        # by walking up the process tree
        local current_pid=$pid
        local found=0
        
        # Check up to 10 levels up the process tree
        for i in {1..10}; do
            # Check if current PID matches any pane PID
            for pane_pid in $pane_pids; do
                if [[ "$current_pid" == "$pane_pid" ]]; then
                    found=1
                    break
                fi
            done
            
            if [[ $found -eq 1 ]]; then
                break
            fi
            
            # Get parent PID
            local parent_pid=$(ps -o ppid= -p "$current_pid" 2>/dev/null | tr -d ' ')
            if [[ -z "$parent_pid" ]] || [[ "$parent_pid" == "1" ]] || [[ "$parent_pid" == "$current_pid" ]]; then
                break
            fi
            current_pid=$parent_pid
        done
        
        if [[ $found -eq 1 ]]; then
            julia_pids+=("$pid")
        fi
    done < <(ps aux | grep -i '[j]ulia' | grep -v 'grep')
    
    # Return space-separated list of PIDs
    if [[ ${#julia_pids[@]} -gt 0 ]]; then
        printf "%s" "${julia_pids[*]}"
    fi
}

_get_session_memory() {
    local session_name="$1"
    local pids_str=$(_get_julia_processes_for_session "$session_name")
    
    if [[ -z "$pids_str" ]]; then
        echo "0"
        return
    fi
    
    # Convert space-separated to array
    local pids=($pids_str)
    local total_memory_kb=0
    
    for pid in "${pids[@]}"; do
        # Get RSS (Resident Set Size) in KB
        local rss=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')
        if [[ -n "$rss" ]]; then
            total_memory_kb=$((total_memory_kb + rss))
        fi
    done
    
    # Convert KB to bytes for formatting
    echo $((total_memory_kb * 1024))
}

cmd_info() {
    local target="${1:-}"
    local sessions_to_show=()
    
    if [[ -z "$target" ]]; then
        # Show info for all Julia sessions
        while IFS= read -r session_line; do
            if [[ -z "$session_line" ]]; then
                continue
            fi
            
            local session_name=$(echo "$session_line" | cut -d: -f1)
            if [[ "$session_name" == julia_* ]]; then
                sessions_to_show+=("$session_name")
            fi
        done < <(tmux list-sessions 2>/dev/null)
        
        if [[ ${#sessions_to_show[@]} -eq 0 ]]; then
            echo "No Julia sessions running."
            return 0
        fi
    else
        # Show info for specific session
        local session_name=$(_resolve_session_name "$target")
        
        if ! tmux has-session -t "$session_name" 2>/dev/null; then
            echo "Error: Julia session '$session_name' not found"
            echo "Use 'juliaserver list' to see running sessions"
            return 1
        fi
        
        sessions_to_show+=("$session_name")
    fi
    
    echo "Julia Session Information"
    echo "========================="
    echo ""
    
    local total_sessions=${#sessions_to_show[@]}
    local session_index=0
    
    for session_name in "${sessions_to_show[@]}"; do
        ((session_index++))
        # Get session metadata from tmux
        local session_info=$(tmux list-sessions -F "#{session_name}:#{session_created}:#{session_windows}:#{session_attached}" 2>/dev/null | grep "^${session_name}:")
        
        if [[ -z "$session_info" ]]; then
            continue
        fi
        
        local created_timestamp=$(echo "$session_info" | cut -d: -f2)
        local attached=$(echo "$session_info" | cut -d: -f4)
        
        # Calculate uptime
        local current_time=$(date +%s)
        local uptime_seconds=$((current_time - created_timestamp))
        local uptime=$(_format_uptime $uptime_seconds)
        
        # Determine project info from session name or stored option
        local project_info=""
        if [[ "$session_name" == "julia_global" ]]; then
            project_info="global environment"
        else
            # Try to get stored project path
            local stored_project=$(tmux show-option -t "$session_name" -v @juliaserver_project 2>/dev/null)
            if [[ -n "$stored_project" ]]; then
                project_info="$stored_project"
            else
                # Fallback to session name parsing
                local proj_name="${session_name#julia_}"
                if [[ "$proj_name" == *"_"* ]]; then
                    # Likely a path-based session, but we can't recover the full path
                    project_info="@$proj_name or path"
                else
                    # Likely an @env session
                    project_info="@$proj_name"
                fi
            fi
        fi
        
        # Get memory usage
        local memory_bytes=$(_get_session_memory "$session_name")
        local memory=$(_format_bytes $memory_bytes)
        
        # Get Julia process PIDs
        local julia_pids_str=$(_get_julia_processes_for_session "$session_name")
        local process_count=0
        local pids_display=""
        
        if [[ -n "$julia_pids_str" ]]; then
            local pids=($julia_pids_str)
            process_count=${#pids[@]}
            if [[ $process_count -eq 1 ]]; then
                pids_display="(PID: ${pids[0]})"
            else
                pids_display="(PIDs: ${julia_pids_str// /, })"
            fi
        fi
        
        # Status: idle/busy from REPL prompt detection, attached/detached from tmux
        local activity="busy"
        if _is_session_idle "$session_name"; then
            activity="idle"
        fi
        local attach_state="detached"
        if [[ "$attached" == "1" ]]; then
            attach_state="attached"
        fi
        local status="$activity ($attach_state)"
        
        # Check for named session label
        local stored_label=$(tmux show-option -t "$session_name" -v @juliaserver_label 2>/dev/null)

        # Display session info
        echo "Session: $session_name"
        if [[ -n "$stored_label" ]]; then
            echo "  Label: $stored_label"
        fi
        echo "  Project: $project_info"
        echo "  Status: $status"
        echo "  Uptime: $uptime"
        echo "  Memory: $memory"
        if [[ $process_count -gt 0 ]]; then
            echo "  Processes: $process_count $pids_display"
        else
            echo "  Processes: 0 (no Julia processes found)"
        fi
        
        # Add separator between sessions
        if [[ $total_sessions -gt 1 ]] && [[ $session_index -lt $total_sessions ]]; then
            echo ""
        fi
    done
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

main() {
    local command="${1:-help}"
    shift || true

    # Extract --name/-n and --history-limit flags for launch command only
    _JLS_SESSION_LABEL=""
    _JLS_HISTORY_LIMIT=""
    case "$command" in
        launch|start|server)
            local filtered_args=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --name=*)
                        _JLS_SESSION_LABEL="${1#--name=}"
                        ;;
                    --name|-n)
                        if [[ -z "${2:-}" ]]; then
                            echo "Error: $1 requires a value"
                            exit 1
                        fi
                        _JLS_SESSION_LABEL="$2"
                        shift
                        ;;
                    --history-limit=*)
                        _JLS_HISTORY_LIMIT="${1#--history-limit=}"
                        ;;
                    --history-limit)
                        if [[ -z "${2:-}" ]]; then
                            echo "Error: $1 requires a value"
                            exit 1
                        fi
                        _JLS_HISTORY_LIMIT="$2"
                        shift
                        ;;
                    *)
                        filtered_args+=("$1")
                        ;;
                esac
                shift
            done
            # `set -u` makes an empty array expansion fatal, which broke
            # `juliaserver launch --name foo` with no project argument.
            set -- ${filtered_args[@]+"${filtered_args[@]}"}
            ;;
    esac

    case "$command" in
        launch|start|server)
            cmd_launch "$@"
            ;;
        run|exec|client)
            cmd_run "$@"
            ;;
        print|output|show)
            cmd_print "$@"
            ;;
        wait)
            cmd_wait "$@"
            ;;
        send)
            cmd_send "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        info)
            cmd_info "$@"
            ;;
        kill|stop)
            cmd_kill "$@"
            ;;
        killall)
            cmd_killall
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            echo "Error: Unknown command '$command'"
            echo "Run 'juliaserver help' for usage information."
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
