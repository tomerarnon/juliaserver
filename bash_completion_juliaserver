#!/usr/bin/env bash
# bash_completion_juliaserver - Bash completion for juliaserver CLI
#
# Installation:
#   Copy to one of these locations (in priority order):
#   - /usr/local/etc/bash_completion.d/juliaserver (Homebrew)
#   - ~/.local/share/bash-completion/completions/juliaserver (XDG)
#   - ~/.bash_completion.d/juliaserver (manual - requires sourcing)
#
# Manual sourcing:
#   Add to ~/.bashrc or ~/.bash_profile:
#   source ~/.bash_completion.d/juliaserver
#
# Author: juliaserver-cli project
# License: MIT

# Helper: Get active julia_* session names from tmux
_juliaserver_get_sessions() {
    tmux list-sessions 2>/dev/null | grep "^julia_" | cut -d: -f1
}

# Helper: Get project specs for completion
# Returns: @env names, ".", and optionally stored project paths
_juliaserver_get_project_specs() {
    local specs="."
    local sessions=$(_juliaserver_get_sessions)

    for session in $sessions; do
        # Skip global session
        [[ "$session" == "julia_global" ]] && continue

        # Extract name after "julia_" prefix
        local name="${session#julia_}"

        # If it's a simple env name (no underscore + hash), extract @env
        # Pattern: julia_dev -> @dev, julia_test -> @test
        # But not: julia_myproject_a3f2 (has hash suffix)
        if [[ "$name" != *_* ]]; then
            specs="$specs @$name"
        fi
    done

    echo "$specs"
}

# Helper: Get named session labels (label names for sessions that have @juliaserver_label)
_juliaserver_get_labels() {
    local labels=""
    local sessions=$(_juliaserver_get_sessions)

    for session in $sessions; do
        local label=$(tmux show-option -t "$session" -v @juliaserver_label 2>/dev/null)
        if [[ -n "$label" ]]; then
            # Use the sanitized name (strip julia_ prefix) as the completion value
            labels="$labels ${session#julia_}"
        fi
    done

    echo "$labels"
}

# Helper: Check if a word looks like a project spec
_juliaserver_is_project_spec() {
    local word="$1"
    [[ "$word" == @* ]] || [[ "$word" == "." ]] || [[ -d "$word" ]]
}

# Main completion function
_juliaserver() {
    local cur prev words cword

    # Initialize completion (compatible with bash 3.x)
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        # Fallback for bash without bash-completion package
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    # Command list (including aliases)
    local commands="launch start server run exec client print output show wait send attach list ls info kill stop killall help version"

    # Position 1: Complete command names
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    # Position 2+: Command-specific completion
    local command="${words[1]}"

    case "$command" in
        launch|start|server)
            # launch [PROJECT] [--name|-n NAME]
            if [[ "$prev" == "--name" ]] || [[ "$prev" == "-n" ]]; then
                # Free-form label, no completions
                COMPREPLY=()
            elif [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--name -n" -- "$cur") )
            else
                local specs=$(_juliaserver_get_project_specs)
                COMPREPLY=( $(compgen -W "$specs" -- "$cur") )
                # Also enable directory completion
                local dirs=$(compgen -d -- "$cur" 2>/dev/null)
                if [[ -n "$dirs" ]]; then
                    COMPREPLY+=( $dirs )
                fi
            fi
            ;;

        run|exec|client)
            # run [PROJECT|LABEL] <SCRIPT> [FLAGS] [ARGS]
            if [[ $cword -eq 2 ]]; then
                # Ambiguous: could be PROJECT, named session label, or SCRIPT
                if [[ "$cur" == @* ]] || [[ "$cur" == "." ]]; then
                    # Looks like PROJECT - complete project specs
                    local specs=$(_juliaserver_get_project_specs)
                    COMPREPLY=( $(compgen -W "$specs" -- "$cur") )
                elif [[ -d "$cur" ]] || [[ "$cur" == */ ]]; then
                    # Looks like a directory path
                    COMPREPLY=( $(compgen -d -- "$cur" 2>/dev/null) )
                else
                    # Could be a named session label or SCRIPT
                    local labels=$(_juliaserver_get_labels)
                    COMPREPLY=( $(compgen -W "$labels" -- "$cur") )
                    # Also complete .jl files and directories
                    COMPREPLY+=( $(compgen -f -X '!*.jl' -- "$cur" 2>/dev/null) )
                    local dirs=$(compgen -d -- "$cur" 2>/dev/null)
                    if [[ -n "$dirs" ]]; then
                        COMPREPLY+=( $dirs )
                    fi
                fi
            elif [[ $cword -eq 3 ]]; then
                # Check if position 2 was a PROJECT
                if _juliaserver_is_project_spec "${words[2]}"; then
                    # Position 3 is SCRIPT
                    COMPREPLY=( $(compgen -f -X '!*.jl' -- "$cur" 2>/dev/null) )
                    local dirs=$(compgen -d -- "$cur" 2>/dev/null)
                    if [[ -n "$dirs" ]]; then
                        COMPREPLY+=( $dirs )
                    fi
                else
                    # Position 2 was SCRIPT, position 3 is flags or args
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=( $(compgen -W "--attach -a --output -o --run-in-main -m --no-color" -- "$cur") )
                    fi
                fi
            elif [[ $cword -ge 4 ]]; then
                # Only complete flags if they start with dash
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "--attach -a --output -o --run-in-main -m --no-color" -- "$cur") )
                fi
            fi
            ;;

        print|output|show)
            # print [TARGET] [LINES] [--no-color]
            # Flexible ordering - TARGET, LINES, and --no-color can appear in different orders

            local has_target=0
            local has_lines=0
            local has_no_color=0

            # Scan existing args to see what's been provided
            for ((i=2; i<cword; i++)); do
                if [[ "${words[i]}" == "--no-color" ]]; then
                    has_no_color=1
                elif [[ "${words[i]}" =~ ^[0-9]+$ ]]; then
                    has_lines=1
                else
                    has_target=1
                fi
            done

            # Complete based on current input and what's missing
            if [[ "$cur" == --* ]]; then
                # Complete --no-color if not provided yet
                [[ $has_no_color -eq 0 ]] && COMPREPLY=( $(compgen -W "--no-color" -- "$cur") )
            elif [[ "$cur" =~ ^[0-9] ]]; then
                # User is typing a number - let them complete it
                COMPREPLY=()
            elif [[ $has_target -eq 0 ]]; then
                # Complete TARGET (session names, labels, or project specs)
                local sessions=$(_juliaserver_get_sessions)
                local specs=$(_juliaserver_get_project_specs)
                local labels=$(_juliaserver_get_labels)
                COMPREPLY=( $(compgen -W "$sessions $specs $labels" -- "$cur") )
            fi
            ;;

        wait)
            # wait [PROJECT] [--timeout SECS]
            local has_target=0
            local has_timeout=0

            for ((i=2; i<cword; i++)); do
                if [[ "${words[i]}" == "--timeout" ]]; then
                    has_timeout=1
                elif [[ ! "${words[i]}" =~ ^[0-9]+$ ]]; then
                    has_target=1
                fi
            done

            if [[ "$prev" == "--timeout" ]]; then
                # Expecting a number after --timeout
                COMPREPLY=()
            elif [[ "$cur" == -* ]]; then
                [[ $has_timeout -eq 0 ]] && COMPREPLY=( $(compgen -W "--timeout" -- "$cur") )
            elif [[ $has_target -eq 0 ]]; then
                local sessions=$(_juliaserver_get_sessions)
                local specs=$(_juliaserver_get_project_specs)
                local labels=$(_juliaserver_get_labels)
                COMPREPLY=( $(compgen -W "$sessions $specs $labels" -- "$cur") )
            fi
            ;;

        send)
            # send [PROJECT|LABEL] <COMMAND>
            if [[ $cword -eq 2 ]]; then
                # Ambiguous: PROJECT, named session label, or COMMAND
                if [[ "$cur" == @* ]] || [[ "$cur" == "." ]]; then
                    # Looks like PROJECT
                    local specs=$(_juliaserver_get_project_specs)
                    COMPREPLY=( $(compgen -W "$specs" -- "$cur") )
                elif [[ -d "$cur" ]] || [[ "$cur" == */ ]]; then
                    # Looks like directory path
                    COMPREPLY=( $(compgen -d -- "$cur" 2>/dev/null) )
                else
                    # Could be named session label or COMMAND
                    local labels=$(_juliaserver_get_labels)
                    COMPREPLY=( $(compgen -W "interrupt $labels" -- "$cur") )
                fi
            elif [[ $cword -eq 3 ]]; then
                # If position 2 was PROJECT or label, complete "interrupt"
                if _juliaserver_is_project_spec "${words[2]}" || tmux has-session -t "julia_${words[2]}" 2>/dev/null; then
                    COMPREPLY=( $(compgen -W "interrupt" -- "$cur") )
                fi
                # Otherwise it's arbitrary Julia code - no completion
            fi
            ;;

        attach|kill|stop)
            # attach <TARGET> or kill <TARGET>
            if [[ $cword -eq 2 ]]; then
                local sessions=$(_juliaserver_get_sessions)
                local specs=$(_juliaserver_get_project_specs)
                local labels=$(_juliaserver_get_labels)
                COMPREPLY=( $(compgen -W "$sessions $specs $labels" -- "$cur") )
                # Also allow directory completion for paths
                local dirs=$(compgen -d -- "$cur" 2>/dev/null)
                if [[ -n "$dirs" ]]; then
                    COMPREPLY+=( $dirs )
                fi
            fi
            ;;

        info)
            # info [TARGET]
            if [[ $cword -eq 2 ]]; then
                local sessions=$(_juliaserver_get_sessions)
                local specs=$(_juliaserver_get_project_specs)
                local labels=$(_juliaserver_get_labels)
                COMPREPLY=( $(compgen -W "$sessions $specs $labels" -- "$cur") )
                # Also allow directory completion for paths
                local dirs=$(compgen -d -- "$cur" 2>/dev/null)
                if [[ -n "$dirs" ]]; then
                    COMPREPLY+=( $dirs )
                fi
            fi
            ;;

        list|ls|killall|help|version)
            # No arguments to complete
            COMPREPLY=()
            ;;

        *)
            # Unknown command - no completion
            COMPREPLY=()
            ;;
    esac

    return 0
}

# Register completion for juliaserver and jls alias
complete -F _juliaserver juliaserver
complete -F _juliaserver jls
